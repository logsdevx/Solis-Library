	BarFill.ZIndex = 3
	BarFill.Image = "rbxassetid://17382033116"

	local UICorner_barfill = Instance.new("UICorner")
	UICorner_barfill.CornerRadius = UDim.new(0, 4)
	UICorner_barfill.Parent = BarFill

	local UIGrad_bar = Instance.new("UIGradient")
	UIGrad_bar.Color = ColorSequence.new{
		ColorSequenceKeypoint.new(0, Color3.fromRGB(66, 89, 182)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(37, 57, 137))
	}
	UIGrad_bar.Parent = BarFill

	-- Reposition all existing notifications upward (stack from bottom)
	local function restack()
		local children = {}
		for _, c in _notify_holder:GetChildren() do
			if c:IsA("Frame") then
				table.insert(children, c)
			end
		end
		-- sort by LayoutOrder so newest is at bottom
		table.sort(children, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
		local total = #children
		for i, c in children do
			local offsetY = (total - i) * (NOTIFY_HEIGHT + NOTIFY_GAP)
			TweenService:Create(c, TweenInfo.new(0.35, Enum.EasingStyle.Circular, Enum.EasingDirection.Out), {
				Position = UDim2.new(0, 0, 1, -(offsetY + NOTIFY_HEIGHT))
			}):Play()
		end
	end

	card.LayoutOrder = Library.notify_count

	-- Slide in
	restack()

	-- Animate progress bar countdown
	TweenService:Create(BarFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0)
	}):Play()

	-- After duration, slide out then destroy
	task.delay(duration, function()
		local slide_out = TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
			Position = UDim2.new(1, NOTIFY_WIDTH + 20, card.Position.Y.Scale, card.Position.Y.Offset)
		})
		slide_out:Play()
		slide_out.Completed:Once(function()
			card:Destroy()
			restack()
		end)
	end)
end

