-- opts: { title, description, duration }
-- duration defaults to 4 seconds

local _notify_holder = nil  -- filled in __init

local NOTIFY_WIDTH  = 280
local NOTIFY_HEIGHT = 64
local NOTIFY_GAP    = 8
local NOTIFY_INSET  = 16    -- from right/bottom edge

function Library:notify(opts)
