			local keybind = Instance.new("TextButton")
			keybind.Name = "Keybind"
			keybind.BackgroundColor3 = Color3.fromRGB(27, 28, 33)
			keybind.BorderColor3 = Color3.fromRGB(0, 0, 0)
			keybind.BorderSizePixel = 0
			keybind.Size = UDim2.new(0, 215, 0, 37)
			keybind.AutoButtonColor = false
			keybind.Font = Enum.Font.SourceSans
			keybind.Text = ""
			keybind.TextColor3 = Color3.fromRGB(0, 0, 0)
			keybind.TextSize = 14
			keybind.Parent = section

			local UICorner_kb = Instance.new("UICorner")
			UICorner_kb.CornerRadius = UDim.new(0, 10)
			UICorner_kb.Parent = keybind

			local KBLabel = Instance.new("TextLabel")
			KBLabel.Parent = keybind
			KBLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			KBLabel.BackgroundTransparency = 1
			KBLabel.BorderSizePixel = 0
			KBLabel.Position = UDim2.new(0.424475819, 0, 0.5, 0)
			KBLabel.Size = UDim2.new(0, 155, 0, 15)
			KBLabel.ZIndex = 2
			KBLabel.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
			KBLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			KBLabel.TextScaled = true
			KBLabel.TextSize = 14
			KBLabel.TextWrapped = true
			KBLabel.TextXAlignment = Enum.TextXAlignment.Left
			KBLabel.Text = opts.name

			local KBBox = Instance.new("Frame")
			KBBox.Name = "Box"
			KBBox.Parent = keybind
			KBBox.AnchorPoint = Vector2.new(0.5, 0.5)
			KBBox.BackgroundColor3 = Color3.fromRGB(22, 23, 27)
			KBBox.BorderColor3 = Color3.fromRGB(0, 0, 0)
			KBBox.BorderSizePixel = 0
			KBBox.Position = UDim2.new(0.9, 0, 0.472972959, 0)
			KBBox.Size = UDim2.new(0, 30, 0, 20)

			local UICorner_kbb = Instance.new("UICorner")
			UICorner_kbb.CornerRadius = UDim.new(0, 4)
			UICorner_kbb.Parent = KBBox

			local KBKeyLabel = Instance.new("TextLabel")
			KBKeyLabel.Parent = KBBox
			KBKeyLabel.AnchorPoint = Vector2.new(0.5, 0.5)
			KBKeyLabel.BackgroundTransparency = 1
			KBKeyLabel.BorderSizePixel = 0
			KBKeyLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
			KBKeyLabel.Size = UDim2.new(0, 29, 0, 15)
			KBKeyLabel.ZIndex = 2
			KBKeyLabel.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
			KBKeyLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			KBKeyLabel.TextScaled = true
			KBKeyLabel.TextSize = 14
			KBKeyLabel.TextWrapped = true

			if Library.Flags[opts.flag] == nil then
				Library.Flags[opts.flag] = opts.keycode.Name
			end

			KBKeyLabel.Text = Library.Flags[opts.flag]

			local listening = false
			keybind.MouseButton1Click:Connect(function()
				if listening then return end
				listening = true
				KBKeyLabel.Text = '...'
				local input = UserInputService.InputBegan:Wait()
				if input.KeyCode ~= Enum.KeyCode.Unknown then
					KBKeyLabel.Text = input.KeyCode.Name
					Library.Flags[opts.flag] = input.KeyCode.Name
					Library.save_flags()
				else
					KBKeyLabel.Text = Library.Flags[opts.flag]
				end
				listening = false
			end)

			UserInputService.InputBegan:Connect(function(current, pressed)
				if not pressed then
					if current.KeyCode.Name == Library.Flags[opts.flag] then
						opts.callback(Library.Flags[opts.flag])
					end
				end
			end)
		end

		return Module
	end

	return Tab
end

-- Call __init and return the Tab API
Library.Tab = Library.__init()

return Library
