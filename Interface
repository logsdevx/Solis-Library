			KBKeyLabel.BorderSizePixel = 0
			KBKeyLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
			KBKeyLabel.Size = UDim2.new(0, 29, 0, 15)
			KBKeyLabel.ZIndex = 2
			KBKeyLabel.FontFace = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.SemiBold)
			KBKeyLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			KBKeyLabel.TextScaled = true
			KBKeyLabel.TextSize = 14
			KBKeyLabel.TextWrapped = true

			if Library.Flags[self.flag] == nil then
				Library.Flags[self.flag] = self.keycode.Name
			end

			KBKeyLabel.Text = tostring(Library.Flags[self.flag])

			local listening = false
			keybind.MouseButton1Click:Connect(function()
				if listening then return end
				listening = true
				KBKeyLabel.Text = "..."
				local input = UserInputService.InputBegan:Wait()
				-- Wait for a non-unknown, non-mouse key
				while input.KeyCode == Enum.KeyCode.Unknown or input.UserInputType ~= Enum.UserInputType.Keyboard do
					input = UserInputService.InputBegan:Wait()
				end
				KBKeyLabel.Text = input.KeyCode.Name
				Library.Flags[self.flag] = input.KeyCode.Name
				Library:save_flags()
				listening = false
			end)

			UserInputService.InputBegan:Connect(function(current, processed)
				if not processed then
					if current.KeyCode.Name == Library.Flags[self.flag] then
						self.callback(Library.Flags[self.flag])
					end
				end
			end)
		end

		return Module
	end
end

