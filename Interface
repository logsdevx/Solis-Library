	-- Progress bar background
	local BarBG = Instance.new("Frame")
	BarBG.Name = "BarBG"
	BarBG.Parent = card
	BarBG.BackgroundColor3 = Color3.fromRGB(22, 23, 27)
	BarBG.BorderSizePixel = 0
	BarBG.Position = UDim2.new(0, 8, 1, -6)
	BarBG.Size = UDim2.new(1, -16, 0, 3)
	BarBG.ZIndex = 2

	local UICorner_bar = Instance.new("UICorner")
	UICorner_bar.CornerRadius = UDim.new(0, 4)
	UICorner_bar.Parent = BarBG

	-- Progress bar fill
	local BarFill = Instance.new("ImageLabel")
	BarFill.Name = "Fill"
	BarFill.Parent = BarBG
	BarFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	BarFill.BackgroundTransparency = 1
	BarFill.BorderSizePixel = 0
	BarFill.AnchorPoint = Vector2.new(0, 0.5)
