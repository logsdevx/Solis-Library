local Library = {
	connections = {},
	Flags = {},
	enabled = true,
	slider_drag = false,
	core = nil,
	dragging = false,
	drag_position = nil,
	start_position = nil,
	is_fullscreen = false,
	notify_count = 0,
}

if not isfolder("Visual") then
	makefolder("Visual")
end

function Library:disconnect()
	for _, value in Library.connections do
		if not Library.connections[value] then
			continue
		end
		Library.connections[value]:Disconnect()
		Library.connections[value] = nil
	end
end

function Library:clear()
	for _, object in CoreGui:GetChildren() do
		if object.Name ~= "Visual" then
			continue
		end
		object:Destroy()
	end
end

function Library:exist()
	if not Library.core then return end
	if not Library.core.Parent then return end
	return true
end

function Library:save_flags()
	if not Library.exist() then return end
	local flags = HttpService:JSONEncode(Library.Flags)
	writefile(`Visual/{game.GameId}.lua`, flags)
end

function Library:load_flags()
	if not isfile(`Visual/{game.GameId}.lua`) then Library.save_flags() return end
	local flags = readfile(`Visual/{game.GameId}.lua`)
	if not flags then Library.save_flags() return end
	Library.Flags = HttpService:JSONDecode(flags)
end

Library.load_flags()
Library.clear()

-- Forward declare container reference so open/close/drag can use it
local _container = nil

-- Stored normal size/position for fullscreen restore
local _normal_container_size = UDim2.new(0, 699, 0, 426)
local _normal_container_pos  = UDim2.new(0.5, 0, 0.5, 0)
local _normal_shadow_size    = UDim2.new(0, 776, 0, 509)
local _normal_shadow_pos     = UDim2.new(0.508668244, 0, 0.5, 0)

function Library:open()
	if not _container then return end
	_container.Container.Visible = true
	_container.Shadow.Visible = true
	_container.Mobile.Modal = true

	TweenService:Create(_container.Container, TweenInfo.new(0.6, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
		Size = Library.is_fullscreen and UDim2.new(1, 0, 1, 0) or _normal_container_size
	}):Play()

	TweenService:Create(_container.Shadow, TweenInfo.new(0.6, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
		Size = Library.is_fullscreen and UDim2.new(1, 60, 1, 80) or _normal_shadow_size
	}):Play()
end

function Library:close()
	if not _container then return end

	TweenService:Create(_container.Shadow, TweenInfo.new(0.6, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
		Size = UDim2.new(0, 0, 0, 0)
	}):Play()

	local main_tween = TweenService:Create(_container.Container, TweenInfo.new(0.6, Enum.EasingStyle.Circular, Enum.EasingDirection.InOut), {
		Size = UDim2.new(0, 0, 0, 0)
	})

	main_tween:Play()
	main_tween.Completed:Once(function()
		if Library.enabled then
			return
		end
		_container.Container.Visible = false
		_container.Shadow.Visible = false
		_container.Mobile.Modal = false
	end)
end

function Library:toggle_visible()
	Library.enabled = not Library.enabled
	if Library.enabled then
		Library:open()
	else
		Library:close()
	end
end

