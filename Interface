						for _, obj in ipairs(Options:GetChildren()) do
							if obj.Name == "Option" then
								TweenService:Create(obj, TweenInfo.new(0.4), {
									TextTransparency = (obj.Text == tostring(value)) and 0 or 0.5
								}):Play()
							end
						end

						if open then
							BoxLabel.Text = tostring(Library.Flags[self.flag])
						end
					end)
				end
			end

			populateOptions()
			self.callback(Library.Flags[self.flag])

			dropdown.MouseButton1Click:Connect(function()
				open = not open
				if open then openDropdown() else closeDropdown() end
			end)

			-- Return a Dropdown object with an update method
			local DropdownObj = {}
			function DropdownObj:update(newOptions)
				self.options = newOptions
				populateOptions()
			end
			return DropdownObj
		end

