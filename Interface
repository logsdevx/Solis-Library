			self.callback(Library.Flags[self.flag])

			local minVal = self.minimum_value
			local maxVal = self.maximum_value
			local flag = self.flag
			local cb = self.callback

			local function updateSlider()
				local result = math.clamp(
					(Mouse.X - Box.AbsolutePosition.X) / Box.AbsoluteSize.X,
					0, 1
				)
				local number = math.floor((((maxVal - minVal) * result) + minVal) * 10) / 10
				local sz = math.clamp(result, 0.001, 0.999)

				Fill.UIGradient.Transparency = NumberSequence.new{
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(sz, 0),
					NumberSequenceKeypoint.new(math.min(sz + 0.001, 1), 1),
					NumberSequenceKeypoint.new(1, 1)
				}
				Glow.UIGradient.Transparency = NumberSequence.new{
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(sz, 0),
					NumberSequenceKeypoint.new(math.min(sz + 0.03, 1), 1),
					NumberSequenceKeypoint.new(1, 1)
				}

				Library.Flags[flag] = number
				Number.Text = tostring(number)
				cb(number)
			end

			Hitbox.MouseButton1Down:Connect(function()
				if Library.slider_drag then return end
				Library.slider_drag = true
				task.spawn(function()
					while Library.slider_drag do
						updateSlider()
						task.wait()
					end
				end)
			end)

			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					if Library.slider_drag then
						Library.slider_drag = false
						Library:save_flags()
					end
				end
			end)
		end

