			local function clear_options()
				for _, obj in Options:GetChildren() do
					if obj.Name == 'Option' then
						obj:Destroy()
					end
				end
			end

			local function select_option(new_option)
				TweenService:Create(new_option, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
				for _, obj in Options:GetChildren() do
					if obj.Name == 'Option' and obj ~= new_option then
						TweenService:Create(obj, TweenInfo.new(0.4), {TextTransparency = 0.5}):Play()
					end
				end
				if drop_open then
					DBoxLabel.Text = new_option.Text
				end
			end

			local function build_options()
				clear_options()
				list_size = 6
				for _, value in opts.options do
					list_size += 23
					local new_option = option_template:Clone()
					new_option.Parent = Options
					new_option.Text = value
					if value == Library.Flags[opts.flag] then
						new_option.TextTransparency = 0
					end
					new_option.MouseButton1Click:Connect(function()
						Library.Flags[opts.flag] = value
						if drop_open then
							DBoxLabel.Text = Library.Flags[opts.flag]
						end
						opts.callback(Library.Flags[opts.flag])
						Library.save_flags()
						select_option(new_option)
					end)
				end
			end

			build_options()

			local function open_dropdown()
				DBoxLabel.Text = Library.Flags[opts.flag]
				TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(0, 202, 0, list_size)}):Play()
				TweenService:Create(dropdown, TweenInfo.new(0.4), {Size = UDim2.new(0, 215, 0, 30 + list_size)}):Play()
				TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 180}):Play()
			end

			local function close_dropdown()
				DBoxLabel.Text = opts.name
				TweenService:Create(Options, TweenInfo.new(0.4), {Size = UDim2.new(0, 202, 0, 0)}):Play()
				TweenService:Create(dropdown, TweenInfo.new(0.4), {Size = UDim2.new(0, 215, 0, 36)}):Play()
				TweenService:Create(Arrow, TweenInfo.new(0.4), {Rotation = 0}):Play()
			end

			dropdown.MouseButton1Click:Connect(function()
				drop_open = not drop_open
				if drop_open then
					open_dropdown()
				else
					close_dropdown()
				end
			end)

			local Dropdown = {}
			function Dropdown:update(new_options)
				opts.options = new_options
				build_options()
			end
			return Dropdown
		end

